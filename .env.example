# Public JSON-RPC endpoint for Robinhood Chain mainnet.
# The public endpoint is rate-limited. A dedicated provider endpoint may be used;
# if it carries an API key, keep the full URL local and never log or commit it.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployed reference contracts. Empty until the deployment gate is cleared.
# These are public addresses. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_ORACLE_GUARD_ADDRESS=

# Deployment only. Never committed, never logged, never echoed.
# DEPLOYER_PRIVATE_KEY=
DEPLOY_ADMIN=
PROJECT_OWNER=
